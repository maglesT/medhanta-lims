{
  "product": "lims",
  "database": "lims",
  "permissions": [
    {
      "code": "lims.master.author",
      "label": "Write master batch record versions"
    },
    {
      "code": "lims.master.check",
      "label": "Check a master batch record version written by another person"
    },
    {
      "code": "lims.master.approve",
      "label": "Approve a checked master batch record version (QA)"
    },
    {
      "code": "lims.batch.issue",
      "label": "Issue a batch record from an approved master version"
    },
    {
      "code": "lims.batch.operate",
      "label": "Record and sign steps of a batch as performed"
    },
    {
      "code": "lims.batch.check",
      "label": "Check steps performed by another person (second person)"
    },
    {
      "code": "lims.batch.supervise",
      "label": "Production approval of a completed batch record"
    },
    {
      "code": "lims.qc.approve",
      "label": "QC approval of the results used for release"
    },
    {
      "code": "lims.qa.release",
      "label": "QA review and release of filled, inspected units"
    },
    {
      "code": "lims.view",
      "label": "View batch records and master versions"
    },
    {
      "code": "lims.demo.skip",
      "label": "Skip a running wait (demo installations only)"
    }
  ],
  "signon": {
    "backchannel_logout": "/backchannel-logout"
  },
  "publishes": [],
  "reads": {
    "master_data": [
      "equipment_v1",
      "instrument_v1",
      "room_v1",
      "material_v1",
      "product_v1"
    ],
    "deviations": [
      "deviation_v1"
    ],
    "qms": [
      "change_v1"
    ],
    "logbook": [
      "equipment_status_v1"
    ],
    "mms": [
      "lot_v1",
      "lot_test_v1"
    ],
    "recruitment": [
      "training_v1"
    ]
  },
  "source": {
    "repo": "https://github.com/maglesT/medhanta-lims",
    "commit": "<full commit id at bundling>"
  }
}
